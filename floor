-- StarterPlayerScripts içine LocalScript olarak koy
local player = game:GetService("Players"):WaitForChild("topraqk1")
local event = game:GetService("ReplicatedStorage"):WaitForChild("PlaceStructure"):WaitForChild("ClientPlacedBlueprint")

-- Başlangıç ve bitiş konumları
local startX = 35
local endX = -157
local y = 19.2
local z = 430
local step = 8 -- her blok arası 8 birim

-- X ekseni boyunca döngü (sadece tek sıra)
for x = startX, endX, -step do
	local args = {
		"Floor2Large",
		CFrame.new(x, y, z, 1, 0, 0, 0, 1, 0, 0, 0, 1),
		player
	}

	event:FireServer(unpack(args))
	task.wait(0.1) -- biraz bekle (lag olmasın diye)
end
